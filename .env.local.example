# Copie este arquivo para .env.local e preencha com as credenciais do seu
# projeto Firebase (Configurações do projeto > Seus apps > Web app).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcional: define uma senha simples para proteger a área /admin.
# Deixe em branco para não exigir senha nenhuma.
NEXT_PUBLIC_ADMIN_PASSCODE=
