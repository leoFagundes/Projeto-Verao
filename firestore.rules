rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // App pessoal: qualquer usuário autenticado (inclusive anônimo, usado
    // automaticamente pelo app) pode ler e escrever. Isso mantém o banco
    // fora do alcance de quem não passou pelo app, sem exigir tela de login.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
